{
  "version": "2",
  "sql": [
    {
      "engine": "postgresql",
      "schema": "../init.sql",
      "gen": {
        "go": {
          "package": "db",
          "out": "../../internal/database",
          "sql_package": "pgx/v5",
          "query_parameter_limit": 2,
          "emit_result_struct_pointers": true,
          "emit_params_struct_pointers": true
        }
      },
      "queries": "../../internal/database/queries"
    }
  ],
  "overrides": {
    "go": {
      "overrides": [
        {
          "db_type": "pg_catalog.timestamp",
          "go_type": "time.Time"
        }
      ]
    }
  }
}